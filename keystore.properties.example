# Template for keystore.properties, which app/build.gradle.kts reads to sign
# app-release.apk with a real key instead of the throwaway debug key.
#
# You normally do not need to copy this by hand:
#   powershell -ExecutionPolicy Bypass -File tools\gen-release-keystore.ps1
# creates the key and writes keystore.properties for you.
#
# keystore.properties is gitignored (it holds passwords). This template is not.
#
# Use FORWARD slashes in storeFile. java.util.Properties treats a backslash as an
# escape character, so C:\Users\you\key.jks loads as C:Usersyoukey.jks and the
# build fails with a keystore-not-found error that looks like a path bug.
#
# storeFile may be absolute or relative to the repository root.

storeFile=C:/Users/you/.lunar-tear/lunar-tear-release.jks
storePassword=
keyAlias=lunartear
# Optional: PKCS#12 keystores normally use the store password for the key too,
# in which case this may be left empty.
keyPassword=
